# ========================================================
# EXEMPLE DE CONFIGURATION - RENDER & PRODUCTION (Aiven MySQL)
# ========================================================

# Base de données Aiven MySQL (Exemple de format Aiven)
# DB_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:XXXXX/defaultdb?sslMode=REQUIRED
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here

# Clé secrète JWT
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://votre-backend-render.onrender.com/login/oauth2/code/google

# Configuration Serveur
SERVER_PORT=8080

# Frontend URL (CORS & OAuth2)
FRONTEND_URL=https://polyshop-interface.onrender.com
